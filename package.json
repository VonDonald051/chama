{
  "name": "chama",
  "version": "0.1.0",
  "private": true,
  "description": "A security-first Kenyan Chama management system foundation. This repository contains no bundled user identities, pre-populated balances, simulated endpoints or public self-registration. The account-access page follows the supplied light/blue split-card visual direction, while the implementation retains financial-platform security boundaries.",
  "homepage": "https://github.com/VonDonald051/chama#readme",
  "bugs": {
    "url": "https://github.com/VonDonald051/chama/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/VonDonald051/chama.git"
  },
  "license": "ISC",
  "author": "osilimong",
  "type": "commonjs",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @chama/web",
    "dev:api": "npm run dev --workspace @chama/api",
    "build": "npm run db:generate && npm run build --workspace @chama/database && npm run build --workspace @chama/api && npm run build --workspace @chama/web",
    "lint": "npm run build --workspace @chama/database && npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:generate": "dotenv_config_path=.env node -r dotenv/config ./node_modules/prisma/build/index.js generate --schema packages/database/prisma/schema.prisma",
    "db:validate": "dotenv_config_path=.env node -r dotenv/config ./node_modules/prisma/build/index.js validate --schema packages/database/prisma/schema.prisma",
    "db:migrate:deploy": "dotenv_config_path=.env node -r dotenv/config ./node_modules/prisma/build/index.js migrate deploy --schema packages/database/prisma/schema.prisma",
    "convex:dev": "convex dev",
    "convex:push": "convex dev --once"
  },
