# Copy to a secret manager / local .env; never commit real values.
NODE_ENV=development

# PostgreSQL: use a separate database and credential per environment.
DATABASE_URL=postgresql://chama_app:replace-me@postgres:5432/chama?schema=public&sslmode=disable

# Web/API service wiring. Browser requests remain relative; Next proxies server-side.
WEB_ORIGIN=http://localhost:3000
API_INTERNAL_URL=http://api:4000
HOST=0.0.0.0
PORT=4000
SESSION_COOKIE_NAME=__Host-chama_session
SESSION_TTL_HOURS=8
COOKIE_SECURE=false

# Generate locally with: openssl rand -base64 48
# Use KMS/envelope-managed material in staging/production.
AUDIT_HASH_KEY=replace-with-at-least-32-random-characters
FIELD_ENCRYPTION_KEY=replace-with-base64-encoded-32-byte-key

# Private object-storage values; no public bucket policy.
S3_ENDPOINT=http://minio:9000
S3_BUCKET=chama-private
S3_ACCESS_KEY=replace-me
S3_SECRET_KEY=replace-me

# Leave external provider variables absent until a documented contract and credentials are configured.
# EMAIL_PROVIDER_API_KEY=
# SMS_PROVIDER_API_KEY=
