# Copy to .env.local for local Next.js builds. Set the same variables in the
# Vercel project dashboard for the required Development, Preview, and
# Production environments. Do not commit .env.local.

# Public HTTPS origin of the Fastify backend; no trailing slash.
API_INTERNAL_URL=https://api.example.com

# Public Convex endpoints for the corresponding deployment, when Convex is used.
NEXT_PUBLIC_CONVEX_URL=https://<deployment>.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://<deployment>.convex.site
